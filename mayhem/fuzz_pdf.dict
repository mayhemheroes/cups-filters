# PDF content-stream operator / token dictionary for fuzz_pdf.
# The harness embeds the input bytes verbatim as a page CONTENT STREAM
# (between `stream` and `endstream`), then drives cups-filters' pdfutils
# pdfOut_* writer. These are the PDF graphics/text operators and structural
# tokens that exercise that content path.

# text objects / operators
"BT"
"ET"
"Td"
"TD"
"Tm"
"Tf"
"Tj"
"TJ"
"Tc"
"Tw"
"Tz"
"TL"
"Ts"
"Tr"
"T*"
"'"
"\""

# graphics state
"q"
"Q"
"cm"
"gs"
"w"
"J"
"j"
"M"
"d"
"ri"
"i"

# path construction / painting
"m"
"l"
"c"
"v"
"y"
"h"
"re"
"S"
"s"
"f"
"F"
"f*"
"B"
"B*"
"b"
"b*"
"n"
"W"
"W*"

# color
"g"
"G"
"rg"
"RG"
"k"
"K"
"cs"
"CS"
"sc"
"SC"
"scn"
"SCN"

# xobjects / images / marked content
"Do"
"BI"
"ID"
"EI"
"sh"
"BMC"
"BDC"
"EMC"
"MP"
"DP"
"BX"
"EX"

# structural / object tokens
"obj"
"endobj"
"stream"
"endstream"
"xref"
"trailer"
"startxref"
"%%EOF"
"/Type"
"/Font"
"/Subtype"
"/Type1"
"/BaseFont"
"/Length"
"/Page"
"/Pages"
"/MediaBox"
"/Contents"
"/Resources"
"<<"
">>"
"[0 0 595 842]"
"Courier"
